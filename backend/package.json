{
  "name": "commit-collector",
  "version": "0.0.1",
  "description": "A commit collector service that normalizes commits from various code repository APIs.",
  "license": "ISC",
  "author": "Dakota Schaeffer",
  "type": "module",
  "main": "src/local/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:lambda": "rm -rf dist && esbuild src/lambda/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/handler.js",
    "start": "node dist/local/index.js",
    "package:lambda": "cd dist && zip -r lambda.zip handler.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "memfs": "^4.64.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/client-secrets-manager": "^3.1119.0"
  }
}
